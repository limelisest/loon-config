#!name=国内常用App·仅开屏
#!desc=仅处理已收录的开屏接口与专用素材；不做页面净化。需 Loon Build 729+、开启 MITM 并信任证书。规则覆盖与限制见 homepage；未完成设备实测。
#!author=limelisest; rules adapted from blackmatrix7/ios_rule_script
#!homepage=https://github.com/limelisest/loon-config/blob/main/plugins/CN-Splash-Only.md
#!date=2026-10-20
# SPDX-License-Identifier: GPL-2.0-only
# Portions adapted from blackmatrix7/ios_rule_script (GPL-2.0).
# Modified 2026-10-20: exact hosts/endpoint boundaries, splash-only selection.
# Source and license: ../sources.md and ../licenses/GPL-2.0.txt
# Standalone source: https://github.com/limelisest/loon-config
# No warranty; see the GPL-2.0 license. Biliverse script is referenced, not bundled.

[Rewrite]
# 京东：保留启动配置，只清空开屏图和展示次数；functionId 必须完整匹配。
^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&#]+&)*functionId=start(?:&|$) response-body-json-jq 'if type=="object" then (if (.images|type)=="array" then .images=[] else . end)|(if (.showTimesDaily|type)=="number" then .showTimesDaily=0 else . end) else . end'
^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&#]+&)*functionId=home_launchConfig(?:&|$) reject-dict
# 小红书：只清空开屏广告组，不处理 system_service/config 或笔记接口。
^https?:\/\/(?:edith|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config(?:\?|$) response-body-json-jq 'if type=="object" then (if (.data|type)=="object" then (if (.data.ads_groups|type)=="array" then .data.ads_groups=[] else . end) else . end) else . end'
# 拼多多
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash(?:\?|$) reject-dict
# 闲鱼：开屏请求与异步预加载；不匹配 idle.home.welcome。
^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.(?:async\.)?ads\/ reject-dict
# 淘宝：同一网关的其他业务不受匹配；noah.query 必须携带 tao_splash 标识。
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/[^?#]*\?[^#]*tao_splash reject-dict
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get\/ reject-dict
# 知乎：只收录两个 launch 接口，不拦整个 commercial_api。
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:launch_v2|real_time_launch_v2)(?:\?|$) reject-dict
# 豆瓣
^https?:\/\/api\.douban\.com\/v2\/app_ads\/splash(?:\?|$) reject-dict
# 高德地图、腾讯地图：仅开屏接口 / 专用素材目录。
^https?:\/\/(?:amap-aos-info-nogw\.amap\.com|m\d\.amap\.com)\/ws\/(?:aos|valueadded)\/alimama\/splash_screen(?:\/|\?|$) reject-dict
^https?:\/\/4gimg\.map\.qq\.com\/mwaSplash\/ reject
# 美团外卖：不拒绝承载其他启动配置的 loadInfo。
^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:startpicture|openscreen)(?:\?|$) reject-dict
# 麦当劳、库迪咖啡、叮咚买菜
^https?:\/\/api\.mcd\.cn\/bff\/portal\/home\/splash(?:\?|$) reject-dict
^https?:\/\/gateway\.abite\.com\/cotti-capi\/customer\/position\/list\?(?:[^&#]+&)*code=cotti-launch-window(?:&|$) reject-dict
^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/startUpScreen(?:\?|$) reject-dict
# 去哪儿、马蜂窝、途牛、途家、希尔顿、穷游
^https?:\/\/client\.qunar\.com\/pitcher-proxy\?(?:[^&#]+&)*qrt=p_splashAd(?:&|$) reject-dict
^https?:\/\/homefront\.qunar\.com\/front\/splash\/ad(?:\?|$) reject-dict
^https?:\/\/mapi\.mafengwo\.cn\/ad\/get_launch_ad_list\/v2(?:\?|$) reject-dict
^https?:\/\/m\.tuniu\.com\/api\/operation\/splash\/ reject-dict
^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getStartPictureAdvertising(?:\?|$) reject-dict
^https?:\/\/wcprd\.hilton\.com\.cn\/app-middleware\/graphql\?(?:[^&#]+&)*type=splashAd(?:&|$) reject-dict
^https?:\/\/open\.qyer\.com\/qyer\/startpage\/ reject-dict
# 腾讯新闻、人民日报
^https?:\/\/r\.inews\.qq\.com\/getSplash(?:\?|$) reject-dict
^https?:\/\/pdapis\.pdnews\.cn\/api\/rmrb-bff-display-zh\/display\/zh\/c\/launchPage(?:\?|$) reject-dict
# 百度贴吧、米游社
^https?:\/\/c\.tieba\.baidu\.com\/c\/s\/splashSchedule(?:\?|$) reject-dict
^https?:\/\/bbs-api\.miyoushe\.com\/apihub\/api\/getAppSplash(?:\?|$) reject-dict
# QQ音乐、酷狗：只拦开屏专用素材，不拦共享广告域名或音乐播放接口。
^https?:\/\/y\.gtimg\.cn\/music\/common\/upload\/t_splash_info\/ reject
^https?:\/\/(?:splashimgbssdl\.yun|splashimgretrybssdl\.cloud)\.kugou\.com\/ reject
# 雪球、中国联通、天翼云盘
^https?:\/\/api\.xueqiu\.com\/snowpard\/launch_strategy\/query\.json(?:\?|$) reject-dict
^https?:\/\/m\.client\.10010\.com\/uniAdmsInterface\/getWelcomeAd(?:\?|$) reject-dict
^https?:\/\/cloud\.189\.cn\/include\/splash\/ reject
# 有道词典、起点读书、向日葵、脉脉
^https?:\/\/cdke\.youdao\.com\/course3\/recommend\/dict\/startup(?:\?|$) reject-dict
^https?:\/\/mage\.if\.qidian\.com\/argus\/api\/v\d+\/client\/getsplashscreen(?:\?|$) reject-dict
^https?:\/\/client-api(?:-v2)?\.oray\.com\/materials\/SLCC_IOS_STARTUP(?:\?|$) reject-dict
^https?:\/\/api\.taou\.com\/sdk\/global\/splash_ad(?:\?|$) reject-dict
^https?:\/\/open\.taou\.com\/maimai\/launch_ad(?:\?|$) reject-dict
# 微博：共享 SDK 请求必须明确指定 sub_ad_type=splash。
^https?:\/\/sdkapp\.uve\.weibo\.com\/[^?#]*\?(?:[^&#]+&)*sub_ad_type=splash(?:&|$) reject-dict

[Script]
# 哔哩哔哩：固定 Biliverse 版本；仅注册四个开屏接口。
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/splash\/(brand\/list|event\/list2|list|show)(\?|$) requires-body=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/response.bundle.js, tag=Bilibili-Splash-Only

[MITM]
hostname=api.m.jd.com, edith.xiaohongshu.com, www.xiaohongshu.com, api.pinduoduo.com, api.yangkeduo.com, acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com, api.zhihu.com, api.douban.com, amap-aos-info-nogw.amap.com, m0.amap.com, m1.amap.com, m2.amap.com, m3.amap.com, m4.amap.com, m5.amap.com, m6.amap.com, m7.amap.com, m8.amap.com, m9.amap.com, 4gimg.map.qq.com, wmapi.meituan.com, api.mcd.cn, gateway.abite.com, maicai.api.ddxq.mobi, client.qunar.com, homefront.qunar.com, mapi.mafengwo.cn, m.tuniu.com, client.tujia.com, wcprd.hilton.com.cn, open.qyer.com, r.inews.qq.com, pdapis.pdnews.cn, c.tieba.baidu.com, bbs-api.miyoushe.com, y.gtimg.cn, splashimgbssdl.yun.kugou.com, splashimgretrybssdl.cloud.kugou.com, api.xueqiu.com, m.client.10010.com, cloud.189.cn, cdke.youdao.com, mage.if.qidian.com, client-api.oray.com, client-api-v2.oray.com, api.taou.com, open.taou.com, sdkapp.uve.weibo.com, app.bilibili.com, app.biliapi.net
